@{
    ViewData["Title"] = "Baja Lógica de Empleado";
    var lista = ViewBag.ListaEmpleados as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<style>
    .table-erp {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        font-size: 13.5px;
    }

        .table-erp th {
            background-color: #0B192C;
            color: #ffffff;
            text-align: left;
            padding: 12px 15px;
            font-weight: 600;
        }

        .table-erp td {
            padding: 12px 15px;
            border-bottom: 1px solid #E5E9F0;
            color: #0B192C;
        }

        .table-erp tr:hover {
            background-color: #F8FAFC;
        }

    .badge-activo {
        background-color: #DCFCE7;
        color: #166534;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .btn-baja {
        background-color: #9A3B3B;
        color: #fff;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-baja:hover {
            background-color: #7F1D1D;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(11, 25, 44, 0.65);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #ffffff;
        width: 100%;
        max-width: 440px;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.25);
        border-top: 5px solid #9A3B3B;
        text-align: center;
    }

        .modal-box h3 {
            color: #0B192C;
            font-size: 20px;
            margin-bottom: 8px;
        }

        .modal-box p {
            color: #64748B;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 22px;
        }

    .modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .btn-cancelar-modal {
        background-color: #E5E9F0;
        color: #0B192C;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-confirmar-baja {
        background-color: #9A3B3B;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

<div class="erp-container">
    <div class="form-card">
        <div class="form-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px;">
            <div>
                <h2>Baja Lógica de Empleados</h2>
                <p>Registra la baja laboral del colaborador (se desactivará también su acceso al sistema si tiene usuario)</p>
            </div>
            <input type="text" id="txtBuscarEmp" onkeyup="filtrarEmpleados()" placeholder="Buscar por nombre o cargo..." style="padding: 9px 14px; border: 1px solid #D0D7DE; border-radius: 6px; font-size: 13.5px; width: 260px;" />
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert-success-erp">@TempData["MensajeExito"]</div>
        }

        <div style="overflow-x:auto;">
            <table class="table-erp" id="tablaEmpleados">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Cargo / Puesto</th>
                        <th>Ingreso</th>
                        <th>Estado</th>
                        <th style="text-align:right;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!lista.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; color:#9BA4B5; padding:25px;">No hay empleados activos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var e in lista)
                        {
                            <tr>
                                <td>#@e.EmpleadoID</td>
                                <td style="font-weight:700;">@e.NombreCompleto</td>
                                <td>@e.Cargo</td>
                                <td>@(e.FechaContratacion != null ? ((DateTime)e.FechaContratacion).ToString("dd/MM/yyyy") : "-")</td>
                                <td><span class="badge-activo">Activo</span></td>
                                <td style="text-align:right;">
                                    <button type="button" class="btn-baja" onclick="abrirModalBajaEmp(@e.EmpleadoID, '@e.NombreCompleto', '@e.Cargo')">
                                        Dar de baja
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL DE CONFIRMACIÓN -->
<div class="modal-overlay" id="modalBajaEmpleado">
    <div class="modal-box">
        <h3>¿Confirmar baja de empleado?</h3>
        <p>
            Estás a punto de registrar la baja lógica de <strong id="modalNombreEmp" style="color:#0B192C;"></strong>
            (<span id="modalCargoEmp"></span>).<br><br>
            Su expediente quedará inactivo y su cuenta de usuario (si existe) será bloqueada.
        </p>

        <form asp-controller="Empleados" asp-action="ProcesarBaja" method="post">
            <input type="hidden" name="id" id="modalEmpId" />
            <div class="modal-actions">
                <button type="button" class="btn-cancelar-modal" onclick="cerrarModalBajaEmp()">Cancelar</button>
                <button type="submit" class="btn-confirmar-baja">Sí, dar de baja</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalBajaEmp(id, nombre, cargo) {
        document.getElementById('modalEmpId').value = id;
        document.getElementById('modalNombreEmp').textContent = nombre;
        document.getElementById('modalCargoEmp').textContent = cargo;
        document.getElementById('modalBajaEmpleado').classList.add('show');
    }
    function cerrarModalBajaEmp() {
        document.getElementById('modalBajaEmpleado').classList.remove('show');
    }
    document.getElementById('modalBajaEmpleado').addEventListener('click', function (e) {
        if (e.target === this) cerrarModalBajaEmp();
    });
    function filtrarEmpleados() {
        const filtro = document.getElementById('txtBuscarEmp').value.toLowerCase();
        document.querySelectorAll('#tablaEmpleados tbody tr').forEach(fila => {
            fila.style.display = fila.textContent.toLowerCase().includes(filtro) ? '' : 'none';
        });
    }
</script>