@model MetalERP.Models.ViewModels.CrearUsuarioViewModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<style>
    .form-card {
        background: #ffffff;
        padding: 35px;
        max-width: 560px;
        margin: 10px auto;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(11, 25, 44, 0.08);
        border-top: 5px solid #C5A880;
    }

        .form-card h2 {
            color: #0B192C;
            margin-bottom: 6px;
            font-size: 22px;
        }

        .form-card p {
            color: #9BA4B5;
            font-size: 13px;
            margin-bottom: 25px;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #0B192C;
            margin-bottom: 6px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #D0D7DE;
            border-radius: 6px;
            font-size: 14px;
            background-color: #FAFAFB;
            outline: none;
            transition: border-color 0.2s;
        }

            .form-group input:focus, .form-group select:focus {
                border-color: #1E3E62;
                background-color: #ffffff;
            }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .password-wrapper input {
            padding-right: 42px;
        }

    .toggle-password {
        position: absolute;
        right: 12px;
        background: none;
        border: none;
        cursor: pointer;
        color: #9BA4B5;
        display: flex;
        align-items: center;
    }

        .toggle-password:hover {
            color: #1E3E62;
        }

    .btn-primary-erp {
        background-color: #1E3E62;
        color: #ffffff;
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-primary-erp:hover {
            background-color: #0B192C;
        }

    .btn-secondary-erp {
        background-color: #E5E9F0;
        color: #0B192C;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        margin-left: 10px;
        display: inline-block;
    }

    .alert-success-erp {
        background-color: #DCFCE7;
        color: #166534;
        border-left: 4px solid #16A34A;
        padding: 12px 15px;
        border-radius: 6px;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .text-danger {
        color: #9A3B3B;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="form-card">
    <h2>Registrar Nuevo Usuario</h2>
    <p>Selecciona al empleado y asigna sus credenciales de acceso a MetalERP</p>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert-success-erp">
            @TempData["MensajeExito"]
        </div>
    }

    <form asp-controller="Usuarios" asp-action="Crear" method="post">
        <!-- Lista desplegable de Empleados -->
        <div class="form-group">
            <label asp-for="EmpleadoID">Empleado</label>
            <select asp-for="EmpleadoID" asp-items="@(ViewBag.Empleados as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                <option value="">-- Selecciona un empleado --</option>
            </select>
            <span asp-validation-for="EmpleadoID" class="text-danger"></span>
        </div>

        <!-- Nombre de Usuario -->
        <div class="form-group">
            <label asp-for="Username">Usuario</label>
            <input asp-for="Username" placeholder="ej. jperez" autocomplete="off" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <!-- Contraseña -->
        <div class="form-group">
            <label asp-for="Password">Contraseña</label>
            <div class="password-wrapper">
                <input asp-for="Password" type="password" id="pass1" placeholder="Mínimo 6 caracteres" />
                <button type="button" class="toggle-password" onclick="verPass('pass1')" title="Mostrar/Ocultar contraseña">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <!-- Confirmar Contraseña -->
        <div class="form-group">
            <label asp-for="ConfirmarPassword">Confirmar Contraseña</label>
            <div class="password-wrapper">
                <input asp-for="ConfirmarPassword" type="password" id="pass2" placeholder="Repite la contraseña" />
                <button type="button" class="toggle-password" onclick="verPass('pass2')" title="Mostrar/Ocultar contraseña">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
        </div>

        <div style="margin-top: 25px;">
            <button type="submit" class="btn-primary-erp">Guardar Usuario</button>
            <a asp-controller="Home" asp-action="Index" class="btn-secondary-erp">Cancelar</a>
        </div>
    </form>
</div>

<script>
    function verPass(idInput) {
        const input = document.getElementById(idInput);
        input.type = input.type === 'password' ? 'text' : 'password';
    }
</script>