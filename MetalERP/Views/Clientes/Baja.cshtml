@model IEnumerable<MetalERP.Models.Entities.Cliente>
@{
    ViewData["Title"] = "Baja de Clientes";
}

<style>
    .table-erp {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        font-size: 13.5px;
    }

        .table-erp th {
            background-color: #0B192C;
            color: #ffffff;
            text-align: left;
            padding: 12px 15px;
            font-weight: 600;
        }

        .table-erp td {
            padding: 12px 15px;
            border-bottom: 1px solid #E5E9F0;
            color: #0B192C;
        }

        .table-erp tr:hover {
            background-color: #F8FAFC;
        }

    .btn-baja {
        background-color: #9A3B3B;
        color: #fff;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(11, 25, 44, 0.65);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #ffffff;
        width: 100%;
        max-width: 440px;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.25);
        border-top: 5px solid #9A3B3B;
        text-align: center;
    }
</style>

<div class="erp-container">
    <div class="form-card">
        <div class="form-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px;">
            <div>
                <h2>Baja de Clientes</h2>
                <p>Desactiva clientes de la cartera manteniendo su historial comercial</p>
            </div>
            <input type="text" id="txtBuscarCli" onkeyup="filtrarCli()" placeholder="Buscar por clave, nombre o RFC..." style="padding: 9px 14px; border: 1px solid #D0D7DE; border-radius: 6px; font-size: 13.5px; width: 260px;" />
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert-success-erp">@TempData["MensajeExito"]</div>
        }

        <table class="table-erp" id="tablaClientes">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Razón Social / Nombre</th>
                    <th>RFC</th>
                    <th>Correo</th>
                    <th style="text-align:right;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center; color:#9BA4B5; padding:25px;">No hay clientes activos registrados.</td></tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.Clave</strong></td>
                            <td>@c.RazonSocial_Nombre</td>
                            <td>@(c.RFC ?? "-")</td>
                            <td>@(c.Correo ?? "-")</td>
                            <td style="text-align:right;">
                                <button type="button" class="btn-baja" onclick="abrirModalBajaCli(@c.ClienteID, '@c.RazonSocial_Nombre', '@c.Clave')">Dar de baja</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="modalBajaCli">
    <div class="modal-box">
        <h3 style="color:#0B192C; margin-bottom:10px;">¿Confirmar baja de cliente?</h3>
        <p style="color:#64748B; font-size:14px; margin-bottom:22px;">
            Estás a punto de dar de baja al cliente <strong id="modalNomCli" style="color:#0B192C;"></strong> (Clave: <span id="modalClaveCli"></span>).
        </p>
        <form asp-action="ProcesarBaja" method="post">
            <input type="hidden" name="id" id="modalCliId" />
            <div style="display:flex; justify-content:center; gap:12px;">
                <button type="button" onclick="document.getElementById('modalBajaCli').classList.remove('show')" class="btn-secondary-erp" style="margin:0;">Cancelar</button>
                <button type="submit" style="background:#9A3B3B; color:#fff; border:none; padding:10px 20px; border-radius:6px; font-weight:600; cursor:pointer;">Sí, dar de baja</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalBajaCli(id, nombre, clave) {
        document.getElementById('modalCliId').value = id;
        document.getElementById('modalNomCli').textContent = nombre;
        document.getElementById('modalClaveCli').textContent = clave;
        document.getElementById('modalBajaCli').classList.add('show');
    }
    function filtrarCli() {
        const val = document.getElementById('txtBuscarCli').value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        document.querySelectorAll('#tablaClientes tbody tr').forEach(tr => {
            const txt = tr.textContent.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
            tr.style.display = txt.includes(val) ? '' : 'none';
        });
    }
</script>